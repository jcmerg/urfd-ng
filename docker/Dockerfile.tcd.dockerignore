# Only reflector/ (the shared sources), tcd/ and the monitor's font go into the tcd image
**/.git
.claude
dashboard
!dashboard/fonts/saira-latin.woff2
dashboard-ws
docs
docker
config
plugins
**/*.o
**/*.d
**/*.so
tcd/tcd
tcd/tcdmon
# built in the image, for its architecture
tcd/plugins/*/mbelib-neo-*
# libradiocodec's source comes from the host (the image has no git access),
# its build is made in the image
tcd/plugins/*/libradiocodec-*/build
tcd/plugins/*/libradiocodec-*/install
tcd/plugins/*/libradiocodec-*/configure.log
