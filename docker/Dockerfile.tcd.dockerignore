# Only reflector/ (the shared sources), tcd/ and the monitor's font go into the tcd image
**/.git
.claude
dashboard
!dashboard/fonts/saira-latin.woff2
docs
docker
config
plugins
**/*.o
**/*.d
**/*.so
tcd/tcd
tcd/tcdmon
reflector/urfd
reflector/inicheck
reflector/dbutil
# built in the image, for its architecture
tcd/plugins/*/mbelib-neo-*
# a library a plugin builds in a directory of its own: its source may come
# from the host (the image has no git access), its build is made in the image
tcd/plugins/*/*/build
tcd/plugins/*/*/install
tcd/plugins/*/*/configure.log
