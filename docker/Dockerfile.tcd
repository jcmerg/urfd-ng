## tcd, the transcoder, in Docker: with AMBE sticks (docker-compose.tcd-sticks.yml,
## which docker/build.sh adds) or in software with a codec plugin
## (tcd/plugins/<name>/, see tcd/plugins/README.md); see "tcd in Docker" in
## tcd/README.md.
##
##   cd docker && docker compose --profile tcd build tcd

## ----- Build Stage -----
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

# apt keeps its downloads in a BuildKit cache across builds: a new ubuntu:24.04
# (Ubuntu refreshes it) rebuilds this layer, but only changed packages are
# downloaded again (ports.ubuntu.com, the arm64 mirror, is often slow)
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache
# the compiler without build-essential (perl, the Debian packaging tools); cmake
# and curl for the codec plugins (a plugin may build or fetch its library)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    cmake \
    curl \
    ca-certificates \
    libspeexdsp-dev \
    libwebsockets-dev \
    libncurses-dev

WORKDIR /build
COPY reflector/ ./reflector/
COPY tcd/ ./tcd/
# the dashboard's font, which embed_html.sh puts into the monitor page
COPY dashboard/fonts/saira-latin.woff2 ./dashboard/fonts/

WORKDIR /build/tcd
RUN make clean >/dev/null 2>&1 || true; make -j$(nproc)

# the codec plugins in tcd/plugins/<name>/, each with a Makefile taking TCD=;
# with each its license and those of the libraries it links statically (the
# share/doc of their install in the plugin's directory)
RUN set -e; mkdir -p /build/plugin-lib /build/plugin-doc; \
    for d in /build/tcd/plugins/*/; do \
        [ -f "$d/Makefile" ] || continue; \
        make -C "$d" -j$(nproc) TCD=/build/tcd; \
        cp "$d"*.so /build/plugin-lib/; \
        doc=/build/plugin-doc/$(basename "$d"); mkdir -p "$doc"; \
        for f in "$d"LICENSE* "$d"NOTICE* "$d"COPYING*; do if [ -f "$f" ]; then cp "$f" "$doc/"; fi; done; \
        for l in "$d"*/install/share/doc/*/; do if [ -d "$l" ]; then cp -r "$l" "$doc/"; fi; done; \
    done

## ----- Runtime Stage -----
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# apt keeps its downloads in a BuildKit cache across builds: a new ubuntu:24.04
# (Ubuntu refreshes it) rebuilds this layer, but only changed packages are
# downloaded again (ports.ubuntu.com, the arm64 mirror, is often slow)
RUN rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' > /etc/apt/apt.conf.d/keep-cache
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    libspeexdsp1 \
    libwebsockets19t64 \
    libncurses6 \
    ca-certificates \
    procps

COPY --from=builder /build/tcd/tcd /build/tcd/tcdmon /usr/local/bin/
COPY --from=builder /build/plugin-lib/ /usr/local/lib/tcd/
COPY --from=builder /build/plugin-doc/ /usr/local/share/doc/tcd-plugins/
COPY tcd/config/tcd.ini /usr/local/share/tcd/tcd.ini.template

# tcd.ini comes from the host ($URFD_DATA/tcd/tcd.ini, see docker-compose.yml)
CMD ["/usr/local/bin/tcd", "/usr/local/etc/tcd/tcd.ini"]
